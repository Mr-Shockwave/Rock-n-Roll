# Copy this file to .env and fill in your values:  cp .env.example .env
# (.env is gitignored; .env.example is the committed template.)

# Butterbase AI gateway — enables real rock identification in `description`.
# Get an ai:gateway-scoped key (starts with bb_sk_) from the Butterbase dashboard.
BUTTERBASE_API_KEY=

# Optional overrides (defaults shown):
BUTTERBASE_VISION_MODEL=anthropic/claude-haiku-4.5
# BUTTERBASE_API_URL=https://api.butterbase.ai

# Camera: 0 = iPhone (Continuity Camera), 1 = built-in laptop cam.
CAMERA_INDEX=0
