# Copy this file to .env and fill in your values:  cp .env.example .env
# (.env is gitignored; .env.example is the committed template.)

# Butterbase — required for scan pipeline + vision
BUTTERBASE_API_KEY=
BUTTERBASE_APP_ID=
# App-scoped API base (recommended):
# BUTTERBASE_API_URL=https://api.butterbase.ai/v1/app_YOUR_APP_ID

# Vision model for mineral classification
BUTTERBASE_VISION_MODEL=anthropic/claude-haiku-4.5

# Camera: 0 = iPhone (Continuity Camera), 1 = built-in laptop cam
CAMERA_INDEX=0

# --- Scan tunables (change these to adjust demo behavior) ---
# Seconds between capture frames during scan loop
SCAN_INTERVAL_SECONDS=2
# Max scan duration before "No promising rocks found"
SCAN_TIMEOUT_SECONDS=30
# Stop scanning when any frame confidence exceeds this
CONFIDENCE_STOP_THRESHOLD=0.5
# Final "needs further analysis" message when avg post-stop confidence >= this
CONFIDENCE_ANALYSIS_MIN=0.5
# Documented relaxed upper band (not a hard cap in v1)
CONFIDENCE_ANALYSIS_MAX=0.7
